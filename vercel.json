{
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "trademetric-rho.vercel.app"
        }
      ],
      "destination": "https://www.trademetric.app/:path*",
      "permanent": false
    }
  ],
  "cleanUrls": true
}
